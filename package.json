{
  "name": "workshop-manager",
  "productName": "Workshop Manager",
  "version": "1.7.6",
  "description": "Create and update items for Steam's Workshop.",
  "author": "Younes Rabeh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "com.workshop.manager",
    "productName": "Workshop Manager",
    "directories": {
      "output": "dist"
    },
    "beforeBuild": "./scripts/build/electron-builder-before-build.mjs",
    "afterSign": "./scripts/build/after-sign.mjs",
    "asar": true,
    "compression": "store",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "resources/img/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "icon": "resources/img/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable"
        }
      ]
    },
    "mac": {
      "icon": "resources/img/app-icon.icns",
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "linux": {
      "icon": "resources/img/app-icon.png",
      "category": "Utility",
      "desktop": {
        "entry": {
          "Name": "Workshop Manager",
          "StartupWMClass": "workshop-manager"
        }
      },
      "target": [
        {
          "target": "AppImage"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/maintenance/clean.mjs",
    "kill:instance": "node scripts/runtime/kill-old-instance.mjs",
    "predev": "pnpm kill:instance",
    "dev": "node scripts/runtime/run-electron-vite-command.mjs dev",
    "dev:icon": "pnpm icon && pnpm dev",
    "icon": "node scripts/build/sync-app-icon.mjs",
    "sync:icon": "pnpm icon",
    "checksums": "node scripts/build/generate-release-checksums.mjs",
    "release:checksums": "pnpm checksums",
    "build:bundle:native": "electron-vite build",
    "build:exe:native": "node scripts/build/build-executable.mjs",
    "build:platform": "node scripts/build/build-platform.mjs",
    "build": "pnpm build:platform bundle",
    "build:bundle": "pnpm build",
    "build:linux": "pnpm build:platform linux",
    "build:win": "pnpm build:platform win",
    "build:all": "pnpm build:platform all",
    "release": "pnpm build:platform all --checksums",
    "preview": "node scripts/runtime/run-electron-vite-command.mjs preview",
    "preview:icon": "pnpm icon && pnpm preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.renderer.json && vue-tsc --noEmit -p tsconfig.renderer-tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:steamcmd:contract": "vitest run test/integration/steamcmd-command-contract.spec.ts",
    "test:steamcmd:live": "vitest run test/integration/steamcmd-live-login.spec.ts",
    "container:test:steamcmd": "node scripts/runtime/run-steamcmd-contract-containers.mjs native",
    "container:test:steamcmd:linux": "node scripts/runtime/run-steamcmd-contract-containers.mjs linux",
    "container:test:steamcmd:linux:live": "node scripts/runtime/run-steamcmd-live-linux.mjs",
    "container:test:steamcmd:linux:script-live": "node scripts/runtime/run-steamcmd-live-linux.mjs --script-mode",
    "container:test:steamcmd:windows:wine": "node scripts/runtime/run-steamcmd-live-linux.mjs --windows-wine",
    "container:test:steamcmd:windows": "node scripts/runtime/run-steamcmd-contract-containers.mjs windows",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
